# Production profile (matches spring-boot prod port)
VITE_PROXY_TARGET=http://localhost:8081

# hCaptcha — DPDP gap #3 (bot protection on registration)
# Create a free account at https://www.hcaptcha.com, add your domain, copy the site key here.
# The matching secret key goes into APP_CAPTCHA_SECRET_KEY on the server.
VITE_HCAPTCHA_SITE_KEY=YOUR_HCAPTCHA_SITE_KEY
