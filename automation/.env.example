# ========================================================
# Mana Community - AI Automation (n8n) Environment Config
# ========================================================

# Network & Host
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# Shared Secret for Webhook Signature Verification (Mana App <-> n8n)
MANA_WEBHOOK_SECRET=mana_community_super_secret_webhook_key_2026

# Mana Backend Target for n8n Action Callbacks
MANA_BACKEND_API_URL=http://host.docker.internal:8082/api

# Free-Tier AI Model Provider Keys (Configure in n8n Credentials or here)
# Get free Gemini API key: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq Cloud (Free Llama 3 inference): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Ollama (if running local model on host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
