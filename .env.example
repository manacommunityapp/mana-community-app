# ==============================================================================
# Mana Community App - Environment Variables Template
# Copy this file to .env.local, .env.development, or .env.production and adjust values.
# Never commit a filled-in env file — only this example is tracked.
# ==============================================================================

# ── Backend Spring Boot API ──────────────────────────────────────────────────
# Base URL for REST API calls (proxied in Vite dev mode to VITE_PROXY_TARGET)
VITE_API_URL=http://localhost:8080/api

# Target backend server for Vite dev server proxy (/api, /ws)
# Development: local Spring Boot backend (port 8080 or 8082)
VITE_PROXY_TARGET=http://localhost:8080

# ── Self-Hosted n8n Automation Engine ────────────────────────────────────────
# Webhook entry point for enterprise AI workflows (default n8n webhook port 5678)
VITE_AUTOMATION_WEBHOOK_URL=http://localhost:5678/webhook

# ── Captcha & Security Verification ──────────────────────────────────────────
# HCaptcha public site key for bot verification (DPDP gap #3)
# Create a free account at https://www.hcaptcha.com, add your domain, copy site key here.
# The matching secret key goes into APP_CAPTCHA_SECRET_KEY on the server.
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# Google reCAPTCHA v2/v3 site key (optional, fallback if hCaptcha is unused)
VITE_RECAPTCHA_SITE_KEY=

# Enforce OTP verification during resident / vendor registration (true | false)
VITE_REGISTRATION_OTP_ENABLED=false
