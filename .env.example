# Copy this file to .env.development (local) or .env.production and fill in real
# values. Never commit a filled-in env file — only this example is tracked.

# Backend proxy target
# Development: local Spring Boot backend (port 8082)
VITE_PROXY_TARGET=http://127.0.0.1:8082
# Production profile uses the spring-boot prod port instead:
# VITE_PROXY_TARGET=http://localhost:8080

# hCaptcha — DPDP gap #3 (bot protection on registration)
# Create a free account at https://www.hcaptcha.com, add your domain, copy the site key here.
# The matching secret key goes into APP_CAPTCHA_SECRET_KEY on the server.
VITE_HCAPTCHA_SITE_KEY=YOUR_HCAPTCHA_SITE_KEY
